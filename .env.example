# === Woonwekker Bellen (Mollie) — Vercel-first ===
#
# PRIMARY: set these in Vercel → Project → Settings → Environment Variables
#          Target: Production (and Preview if desired). Type: Sensitive / server-only.
#          NEVER expose MOLLIE_API_KEY to the frontend / NEXT_PUBLIC_* / client bundles.
#
#   MOLLIE_API_KEY=live_…          # or test_… for Mollie test mode
#   WW_ENTITLEMENT_SECRET=…        # long random string; required on Vercel so cookies
#                                  # verify across serverless isolates
#   WW_PUBLIC_BASE=https://YOUR_DOMAIN   # optional; auto from Host if unset
#
# LOCAL BOX DEV ONLY (optional): copy to .env — never commit .env
# Without MOLLIE_API_KEY the app FAILS CLOSED (checkout 503, no unlock).
MOLLIE_API_KEY=
WW_ENTITLEMENT_SECRET=
WW_PUBLIC_BASE=http://127.0.0.1:4174
WW_PORT=4174
WW_HOST=127.0.0.1

# === Google OAuth (open — any Google account; no hd= / workspace restriction) ===
# Server-only. Create OAuth 2.0 Client ID (Web) in Google Cloud Console.
# Consent screen: External (any Gmail/Google account). Authorized redirect URIs:
#   http://127.0.0.1:4174/api/auth/google/callback
#   https://YOUR_DOMAIN/api/auth/google/callback
# Without GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET: /api/auth/google → 503, googleConfigured:false.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; default = ${WW_PUBLIC_BASE||publicBase}/api/auth/google/callback
GOOGLE_REDIRECT_URI=
# Optional override for signing ww_session / ww_oauth_state (else WW_ENTITLEMENT_SECRET)
WW_AUTH_SECRET=

# === Resend (email confirmation for self-serve signup) ===
# Google login does NOT send confirmation. Email signup MUST.
# Fail-closed without RESEND_API_KEY: POST /api/auth/signup → 503, no pretend send.
# Resend dashboard → Domains → add woonwekker.nl → DNS SPF/DKIM → API key → Vercel Production.
RESEND_API_KEY=
# Must match a verified domain/sender in Resend
RESEND_FROM=Woonwekker <noreply@woonwekker.nl>
