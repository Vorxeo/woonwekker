{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": true,
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/legal",
      "destination": "/voorwaarden/",
      "permanent": true
    },
    {
      "source": "/legal/",
      "destination": "/voorwaarden/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/listings.full.json",
      "destination": "/api/not-found"
    },
    {
      "source": "/data/(.*)",
      "destination": "/api/not-found"
    },
    {
      "source": "/plaats",
      "destination": "/api/not-found?gone=1"
    },
    {
      "source": "/plaats/",
      "destination": "/api/not-found?gone=1"
    },
    {
      "source": "/plaats/:path*",
      "destination": "/api/not-found?gone=1"
    },
    {
      "source": "/api/plaats",
      "destination": "/api/not-found?gone=1"
    },
    {
      "source": "/api/plaats/",
      "destination": "/api/not-found?gone=1"
    },
    {
      "source": "/api/withdrawal",
      "destination": "/api/billing-portal?action=withdraw"
    },
    {
      "source": "/api/withdrawal/",
      "destination": "/api/billing-portal?action=withdraw"
    },
    {
      "source": "/api/cancel",
      "destination": "/api/billing-portal?action=cancel"
    },
    {
      "source": "/api/cancel/",
      "destination": "/api/billing-portal?action=cancel"
    },
    {
      "source": "/listings.json",
      "destination": "/api/listings"
    },
    {
      "source": "/api/checkout/return",
      "destination": "/api/checkout/return"
    },
    {
      "source": "/api/mollie/webhook",
      "destination": "/api/mollie/webhook"
    },
    {
      "source": "/api/auth/callback/google",
      "destination": "/api/auth/google/callback"
    },
    {
      "source": "/api/auth/google/callback",
      "destination": "/api/auth/google/callback"
    },
    {
      "source": "/api/auth/google",
      "destination": "/api/auth/google"
    },
    {
      "source": "/api/auth/status",
      "destination": "/api/auth/actions?action=status"
    },
    {
      "source": "/api/auth/status/",
      "destination": "/api/auth/actions?action=status"
    },
    {
      "source": "/api/auth/me",
      "destination": "/api/auth/actions?action=me"
    },
    {
      "source": "/api/auth/me/",
      "destination": "/api/auth/actions?action=me"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth/actions?action=logout"
    },
    {
      "source": "/api/auth/logout/",
      "destination": "/api/auth/actions?action=logout"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth/actions?action=signup"
    },
    {
      "source": "/api/auth/signup/",
      "destination": "/api/auth/actions?action=signup"
    },
    {
      "source": "/api/auth/confirm",
      "destination": "/api/auth/actions?action=confirm"
    },
    {
      "source": "/api/auth/confirm/",
      "destination": "/api/auth/actions?action=confirm"
    },
    {
      "source": "/api/listing/:id",
      "destination": "/api/listing/[id]?id=:id"
    },
    {
      "source": "/api/listing/:id/",
      "destination": "/api/listing/[id]?id=:id"
    },
    {
      "source": "/api/checkout/return/",
      "destination": "/api/checkout/return"
    },
    {
      "source": "/api/mollie/webhook/",
      "destination": "/api/mollie/webhook"
    },
    {
      "source": "/api/auth/callback/google/",
      "destination": "/api/auth/google/callback"
    },
    {
      "source": "/api/auth/google/callback/",
      "destination": "/api/auth/google/callback"
    },
    {
      "source": "/api/auth/google/",
      "destination": "/api/auth/google"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/listings.js": {
      "includeFiles": "data/listings.full.json"
    },
    "api/listing/*.js": {
      "includeFiles": "data/listings.full.json"
    }
  }
}
